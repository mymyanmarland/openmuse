{
  "expo": {
    "name": "ShweMind",
    "slug": "shwemind",
    "scheme": "shwemind",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.shwemind.mobile"
    },
    "android": {
      "package": "app.shwemind.mobile"
    },
    "web": {
      "bundler": "metro",
      "name": "ShweMind"
    },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
